# Admin SPA environment template. Copy to admin/.env and adjust.
# VITE_* values are exposed to the client build and used to configure the
# Vite dev-server proxy targets (see admin/vite.config.ts).

# Admin API base (dev proxy target; "" keeps same-origin proxying)
VITE_API_URL=http://localhost:8080

# Client runtime base (dev proxy target for /runtime, /build, /dev)
VITE_CLIENT_URL=http://localhost:18080