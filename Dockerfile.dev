FROM node:22-alpine
WORKDIR /workspace

COPY package.json package-lock.json ./
COPY ui-runtime/package.json ui-runtime/
COPY ui-kit/package.json ui-kit/
COPY admin/package.json admin/
RUN npm ci --no-audit --no-fund

COPY . .
EXPOSE 5173
CMD ["npm", "-w", "admin", "run", "dev", "--", "--host", "0.0.0.0"]