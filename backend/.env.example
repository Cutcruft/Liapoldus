# Copy to backend/.env and adjust. All variables except the two marked
# optional are REQUIRED. There are no defaults: the server refuses to start
# when any required variable is missing.

# HTTP listeners
LIAPOLDUS_ADMIN_ADDR=:8080
LIAPOLDUS_CLIENT_ADDR=:18080

# Admin HTTP Basic auth (optional; empty disables auth)
LIAPOLDUS_ADMIN_TOKEN=

# Storage: memory | postgres
LIAPOLDUS_STORAGE=postgres
LIAPOLDUS_DATABASE_URL=postgres://liapoldus:liapoldus@localhost:5432/liapoldus?sslmode=disable

# Assets on disk
LIAPOLDUS_ASSET_DIR=../data/assets

# Client resolution
LIAPOLDUS_CLIENT_DEFAULT_SLUG=

# i18n
LIAPOLDUS_DEFAULT_LOCALE=ru

# Redirects (route service)
LIAPOLDUS_REDIRECT_DEFAULT_STATUS=301
LIAPOLDUS_REDIRECT_ALLOWED_STATUSES=301,302

# Page tree validation
LIAPOLDUS_COMPONENT_MAX_DEPTH=5
LIAPOLDUS_COMPONENT_TYPES=Container,Text,Heading,Paragraph,Image,Button
LIAPOLDUS_PAGE_INITIAL_VERSION=1

# Form submission validation
LIAPOLDUS_EMAIL_PATTERN=^[^@\s]+@[^@\s]+\.[^@\s]+$

# Asset metadata. The URL template MUST contain the {id} placeholder.
LIAPOLDUS_MASTER_VARIANT_NAME=master
LIAPOLDUS_ASSET_FALLBACK_NAME=asset
LIAPOLDUS_ASSET_FALLBACK_MIME=application/octet-stream
LIAPOLDUS_ASSET_FILE_URL_TEMPLATE=/api/assets/{id}/file
LIAPOLDUS_ASSET_CACHE_MAX_AGE_SECONDS=31536000
LIAPOLDUS_MAX_UPLOAD_BYTES=10485760

# HTTP server timeouts
LIAPOLDUS_STARTUP_TIMEOUT=15s
LIAPOLDUS_SHUTDOWN_TIMEOUT=10s
LIAPOLDUS_READ_HEADER_TIMEOUT=5s